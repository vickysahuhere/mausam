# ==============================================================================
# MAUSAM ENVIRONMENT CONFIGURATION
# ==============================================================================

# Supabase Project Configuration
# 1. Create a project at https://supabase.com
# 2. Go to Project Settings -> API
# 3. Paste your Project URL and Project Anon/Public API Key below:
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key

# Optional: Map or external weather API keys if customized
# (By default Open-Meteo and RainViewer Doppler radar do not require API keys)
