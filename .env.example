# ==========================================
# MAUSAM ENVIRONMENT VARIABLES (CLIENT-SIDE)
# ==========================================
# 
# Instructions:
# 1. Copy this file to '.env' (which is git-ignored).
# 2. Replace the placeholder values with your actual configuration.
# 
# WARNING: Only place public, safe-to-expose keys here.
# Prefix client-accessible variables with EXPO_PUBLIC_.
# DO NOT put Supabase service_role keys or private API keys in this file!

# Supabase Public Configuration
# Used by the React Native client for anonymous access and authentication.
EXPO_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
EXPO_PUBLIC_SUPABASE_ANON_KEY="your-public-anon-key"
